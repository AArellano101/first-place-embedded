menu "First Place table box"
    config BOX_ANALOG_RGB
        bool "Analog RGB LED instead of three separate red/yellow/green lamps"
        default n
    config BOX_LED_RED
        int "Red lamp output GPIO (top)"
        range 0 33
        default 25
    config BOX_LED_YELLOW
        int "Yellow lamp output GPIO (middle), or BLUE channel for analog RGB"
        range 0 33
        default 26
    config BOX_LED_GREEN
        int "Green lamp output GPIO (bottom)"
        range 0 33
        default 27
    config BOX_LED_STATUS
        int "Separate no-signal LED GPIO (-1 disables it)"
        range -1 33
        default 23
    config BOX_LED_ACTIVE_LOW
        int "Lamp polarity: 0 active high, 1 active low"
        range 0 1
        default 0
    config BOX_BRIGHTNESS
        int "Maximum lamp brightness (percent)"
        range 1 100
        default 50
    config BOX_PULSE_MS
        int "Yellow breathing cycle (milliseconds)"
        range 500 10000
        default 2000
    config BOX_OLED_ENABLED
        bool "Optional SSD1306 status OLED"
        default y
    config BOX_OLED_SDA
        int "OLED SDA GPIO"
        range 0 33
        default 21
    config BOX_OLED_SCL
        int "OLED SCL GPIO"
        range 0 33
        default 22
    config BOX_OLED_ADDRESS
        hex "OLED address (SSD1306 128x64 assumed)"
        range 0x08 0x77
        default 0x3C
endmenu
