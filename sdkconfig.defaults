CONFIG_IDF_TARGET="esp32"
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_BOX_LED_RED=25
CONFIG_BOX_LED_YELLOW=26
CONFIG_BOX_LED_GREEN=27
CONFIG_BOX_LED_STATUS=23
CONFIG_BOX_LED_ACTIVE_LOW=0
CONFIG_BOX_BRIGHTNESS=50
CONFIG_BOX_PULSE_MS=2000
CONFIG_BOX_OLED_ENABLED=y
CONFIG_BOX_OLED_SDA=21
CONFIG_BOX_OLED_SCL=22
CONFIG_BOX_OLED_ADDRESS=0x3C
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
